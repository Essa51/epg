    "# خلية 5.1: تنزيل M3U من Dropbox (إن لم يُرفع م3u يدويًا) وتحليلها لاستخراج tvg-ids والأسماء\n",
    "import requests\n",
    "def download_dropbox_m3u(dropbox_link):\n",
    "    try:\n",
    "        direct = dropbox_link.replace('?dl=0', '?dl=1')\n",
    "        r = requests.get(direct, timeout=60)\n",
    "        r.raise_for_status()\n",
    "        return r.content.decode('utf-8', errors='ignore')\n",
    "    except Exception as e:\n",
    "        print('Failed to download Dropbox M3U:', e)\n",
    "        return None\n",
    "\n",
    "if (not m3u_text or m3u_text.strip()==\"\") and dropbox_m3u:\n",
    "    print('Attempting to download M3U from Dropbox...')\n",
    "    m3u_text = download_dropbox_m3u(dropbox_m3u)\n",
    "    if m3u_text:\n",
    "        # save local copy in downloads\n",
    "        path = os.path.join('downloads', 'dropbox_m3u.txt')\n",
    "        with open(path, 'w', encoding='utf-8') as f:\n",
    "            f.write(m3u_text)\n",
    "        downloaded_files.append(path)\n",
    "        print('Saved Dropbox M3U to', path)\n",
    "\n",
    "# تحليل M3U لاستخراج tvg-id والاسم\n",
    "FILTER_ALLOWED_TVGS = set()\n",
    "FILTER_ALLOWED_NAMES = set()\n",
    "\n",
    "def norm_name(s):\n",
    "    if s is None: return ''\n",
    "    return re.sub(r\\"\\s+\\", ' ', s.strip().lower())\n",
    "\n",
    "if m3u_text:\n",
    "    lines = m3u_text.splitlines()\n",
    "    i = 0\n",
    "    entries = []\n",
    "    while i < len(lines):\n",
    "        line = lines[i].strip()\n",
    "        if line.startswith('#EXTINF'):\n",
    "            ext = line\n",
    "            # next line maybe stream url\n",
    "            stream = ''\n",
    "            if i+1 < len(lines):\n",
    "                stream = lines[i+1].strip()\n",
    "            m_tvg = re.search(r'tvg-id=\"([^\"]+)\"', ext)\n",
    "            tvg = m_tvg.group(1).strip() if m_tvg else None\n",
    "            m_name = re.search(r',\s*(.+)$', ext)\n",
    "            name = m_name.group(1).strip() if m_name else ''\n",
    "            entries.append({'tvg': tvg, 'name': name, 'stream': stream, 'ext': ext})\n",
    "            if tvg:\n",
    "                FILTER_ALLOWED_TVGS.add(tvg)\n",
    "            if name:\n",
    "                FILTER_ALLOWED_NAMES.add(norm_name(name))\n",
    "            i += 2\n",
    "        else:\n",
    "            i += 1\n",
    "    print(f'Parsed M3U entries: {len(entries)}, with tvg-id: {sum(1 for e in entries if e[\"tvg\"])}, without tvg-id: {sum(1 for e in entries if not e[\"tvg\"]) }')\n",
    "    # احفظ تقارير بسيطة\n",
