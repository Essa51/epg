    "# خلية 3: الدوال المساعدة لتحميل واستخراج الملفات\n",
    "import requests, gzip, io, re, xml.etree.ElementTree as ET, os, zipfile, tarfile\n",
    "from collections import OrderedDict\n",
    "from urllib.parse import unquote, urlsplit\n",
    "\n",
    "def filename_from_cd(resp, url):\n",
    "    cd = resp.headers.get('content-disposition')\n",
    "    if cd:\n",
    "        m = re.search(r'filename\\*=UTF-8\\'\\'(.+)', cd)\n",
    "        if m:\n",
    "            return unquote(m.group(1))\n",
    "        m = re.search(r'filename=\"?([^\";]+)\"?', cd)\n",
    "        if m:\n",
    "            return m.group(1)\n",
    "    # fallback to last part of URL\n",
    "    return urlsplit(url).path.split('/')[-1] or \"downloaded_file\"\n",
    "\n",
    "def download_to_path(url, outdir=\"downloads\"):\n",
    "    os.makedirs(outdir, exist_ok=True)\n",
    "    headers = {\"User-Agent\":\"Mozilla/5.0\"}\n",
    "    try:\n",
    "        r = requests.get(url, headers=headers, stream=True, timeout=60)\n",
    "        r.raise_for_status()\n",
    "        fname = filename_from_cd(r, url)\n",
    "        local = os.path.join(outdir, fname)\n",
    "        with open(local, \"wb\") as f:\n",
    "            for chunk in r.iter_content(32768):\n",
    "                if chunk:\n",
    "                    f.write(chunk)\n",
    "        print(\"Downloaded:\", local)\n",
    "        return local\n",
    "    except Exception as e:\n",
    "        print(\"Download failed:\", e)\n",
    "        return None\n",
    "\n",
    "def extract_if_archive(path, outdir=\"downloads\"):\n",
    "    found = []\n",
    "    lower = path.lower()\n",
    "    if zipfile.is_zipfile(path):\n",
    "        with zipfile.ZipFile(path, 'r') as z:\n",
    "            z.extractall(outdir)\n",
    "            for name in z.namelist():\n",
    "                found.append(os.path.join(outdir, name))\n",
    "    elif tarfile.is_tarfile(path):\n",
    "        with tarfile.open(path, 'r:*') as t:\n",
    "            t.extractall(outdir)\n",
    "            for member in t.getmembers():\n",
    "                found.append(os.path.join(outdir, member.name))\n",
    "    else:\n",
    "        # not archive, return the file itself\n",
    "        found.append(path)\n",
    "    return found\n",
    "\n",
    "def is_epg_file(path):\n",
    "    p = path.lower()\n",
    "    return p.endswith(\".xml\") or p.endswith(\".xml.gz\") or p.endswith(\".gz\")\n",
    "\n",
    "def is_m3u_file(path):\n",
    "    p = path.lower()\n",
    "    return p.endswith(\".m3u\") or p.endswith(\".m3u8\") or p.endswith(\".txt\")"
   ]
