    "# خلية 6: دمج ملفات EPG (xml / .gz) مع تجاهل التكرار حسب القواعد المطلوبة\n",
    "def parse_epg_file(path):\n",
    "    try:\n",
    "        if path.lower().endswith(\".gz\"):\n",
    "            with gzip.open(path, 'rb') as f:\n",
    "                data = f.read()\n",
    "            root = ET.fromstring(data)\n",
    "        else:\n",
    "            root = ET.parse(path).getroot()\n",
    "        return root\n",
    "    except Exception as e:\n",
    "        print(\"Failed parse:\", path, e)\n",
    "        return None\n",
    "\n",
    "channels = OrderedDict()\n",
    "programs_set = set()\n",
    "programs_list = []\n",
    "display_to_id = {}\n",
    "\n",
    "def norm(s):\n",
    "    if s is None: return \"\"\n",
    "    return re.sub(r\"\\s+\", \" \", s.strip().lower())\n",
    "\n",
    "for path in downloaded_files:\n",
    "    if not os.path.isfile(path):\n",
    "        continue\n",
    "    if is_epg_file(path):\n",
    "        print(\"Parsing EPG file:\", path)\n",
    "        root = parse_epg_file(path)\n",
    "        if root is None:\n",
    "            continue\n",
    "        for child in list(root):\n",
    "            tag = child.tag.lower()\n",
    "            # tag may have namespace: use endswith\n",
    "            if tag.endswith(\"channel\"):\n",
    "                ch_id = child.get('id') or \"\"\n",
    "                if not ch_id:\n",
    "                    dn = child.find('.//display-name')\n",
    "                    if dn is not None and dn.text:\n",
    "                        ch_id = norm(dn.text)\n",
    "                if ch_id:\n",
    "                    channels[ch_id] = child  # latest replaces earlier\n",
    "                    dn = child.find('display-name')\n",
    "                    if dn is not None and dn.text:\n",
    "                        display_to_id[norm(dn.text)] = ch_id\n",
    "            elif tag.endswith(\"programme\"):\n",
    "                ch = child.get('channel') or \"\"\n",
    "                start = child.get('start') or \"\"\n",
    "                stop = child.get('stop') or \"\"\n",
    "                title_elem = child.find('title')\n",
    "                title = title_elem.text if title_elem is not None and title_elem.text else \"\"\n",
    "                key = (ch, start, stop, norm(title))\n",
    "                if key in programs_set:\n",
    "                    continue\n",
    "                programs_set.add(key)\n",
    "                programs_list.append(child)\n",
    "    else:\n",
    "        print(\\"Skipping non-EPG file:\\", path)\n",
    "\n",
    "# --- تطبيق فلترة M3U إن كانت المعطيات متاحة (FILTER_ALLOWED_TVGS / NAMES) ---\n",
    "try:\n",
    "    allowed_tvgs = FILTER_ALLOWED_TVGS\n",
    "    allowed_names = FILTER_ALLOWED_NAMES\n",
    "    print('Applying M3U-based filtering: keeping only channels in the M3U list.')\n",
    "    # فلترة القنوات: إذا كان لدى القناة id في allowed_tvgs أو display-name في allowed_names احتفظ بها\n",
    "    filtered_channels = OrderedDict()\n",
    "    for ch_id, ch_elem in channels.items():\n",
    "        keep = False\n",
    "        if ch_id and ch_id in allowed_tvgs:\n",
    "            keep = True\n",
    "        else:\n",
    "            dn = ch_elem.find('display-name')\n",
    "            if dn is not None and norm(dn.text) in allowed_names:\n",
    "                keep = True\n",
    "        if keep:\n",
    "            filtered_channels[ch_id] = ch_elem\n",
    "    # فلترة البرامج: أبقِ البرامج التي يشير حقل 'channel' الخاص بها إلى إحدى القنوات المصفاة\n",
    "    filtered_programs = []\n",
    "    for prog in programs_list:\n",
    "        ch = prog.get('channel') or \"\"\n",
    "        if ch in filtered_channels:\n",
    "            filtered_programs.append(prog)\n",
    "        else:\n",
    "            if ch and norm(ch) in allowed_names:\n",
    "                filtered_programs.append(prog)\n",
    "    channels = filtered_channels\n",
    "    programs_list = filtered_programs\n",
    "    print(f'Channels kept: {len(channels)}, programs kept: {len(programs_list)}')\n",
    "except NameError:\n",
    "    print('No FILTER_ALLOWED_* variables found — skipping M3U filtering.')\n",
    "\n",
    "# build final tree and save\n",
    "tv_root = ET.Element(\"tv\")\n",
    "for ch in channels.values():\n",
    "    tv_root.append(ch)\n",
    "for p in programs_list:\n",
    "    tv_root.append(p)\n",
    "\n",
    "ET.ElementTree(tv_root).write(OUTPUT_EPG, encoding=\"utf-8\", xml_declaration=True)\n",
    "print(\\"Saved EPG:\\", OUTPUT_EPG)"
   ]
  },
