{ "cells": [ { "cell_type": "markdown", "metadata": {}, "source": [ "هذا النوتبوك يقوم بالآتي:\n", "- تنزيل روابط EPG المعروفة\n", "- تنزيل ملف FromSmash الذي تضع رابطه في المتغيّر smash_url\n", "- فك الأرشيفات إن وجدت\n", "- دمج ملفات EPG مع تجاهل التكرار (قنوات: استبدال بالأحدث، برامج: تجنّب التكرار)\n", "- إنشاء أو تحديث ملف M3U وربط tvg-id حيث أمكن\n", "- ينتج final_epg.xml و final_m3u.m3u للتحميل\n\n", "تعليمات سريعة:\n", "1. لا حاجة لتعديل anything لأن smash_url مُعبأ تلقائيًا.\n", "2. شغّل الخلايا بالترتيب.\n", "3. إذا انتهت صلاحية الرابط قم برفع الملف يدوياً في الخلية الخاصة بالرفع." ] }, { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [ "# خلية 1: تثبيت المكتبات\n", "!pip install -q requests" ] }, { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [ "# خلية 2: إعداد المتغيرات (الرابط مُدرَج هنا)\n", "smash_url = \"https://download.eu-central-1.fromsmash.co/transfer/vT8nL8baUJ-dt/file/f5080cd5e92cf6de4fd4a2fad3af5ac7eac0bdfa?identity=91c24e45dc98a51930ae14ccf8ad03e6-0251a2f2d55f47221b2f2734c9a992ae68f6d9df0261b070ae5be9c20b64108533e696b76009a58da788da63ca921900f9ab01ec76d5df7d4323ba5df7410cb6e67948f834f0448bef34938175b86a11&Expires=1781081164&Key-Pair-Id=APKAIM76HR2FWFZRN3HA&Signature=az1DCUUpmuI9xtIgSbnovmrMnnpleDG9sFaecfCmCGC9qiWJ7Kfq2a51p5IMfzB8nWBBTcRfOONnKFe5GxfvSm0Es3telKZYTv~yrUEzp5pHFblM8-7pDpdf9CTnecK4EPD2wHfE4Q26ystHiPnRyS2MB3DYl8gOTM9KoMYd36oKe-BStfqikzGWELHlT3n8SyW94GOcefrlIAICWMUFiKcuaM2xRoNiAmMtQDtjrTQt-R-gEjwa1DbXEGgicElsYk8nf8gSY7jZ6-tTYc6iC4xwlH4e8xC1zoQuKY6xbwQrNOuyvjoxVGN0-tqFrT0biy6v-foO3ZYX2nefGHDdWA__\"\n", "epg_links = [\n", "    \"https://raw.githubusercontent.com/Essa51/arabic_epg.xml/main/arabic_clean_epg.xml\",\n", "    \"https://epgshare01.online/epgshare01/epg_ripper_SA1.xml.gz\",\n", "    \"https://epgshare01.online/epgshare01/epg_ripper_SA2.xml.gz\",\n", "    \"https://raw.githubusercontent.com/MuazT/EPG-Guide/master/ArabicEPG.xml\"\n", "]\n", "OUTPUT_EPG = \"final_epg.xml\"\n", "OUTPUT_M3U = \"final_m3u.m3u\"" ] }, { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [ "# خلية 3: الدوال المساعدة لتحميل واستخراج الملفات\n", "import requests, gzip, io, re, xml.etree.ElementTree as ET, os, zipfile, tarfile\n", "from collections import OrderedDict\n", "from urllib.parse import unquote, urlsplit\n", "\n", "def filename_from_cd(resp, url):\n", "    cd = resp.headers.get('content-disposition')\n", "    if cd:\n", "        m = re.search(r'filename\\*=UTF-8\\'\\'(.+)', cd)\n", "        if m:\n", "            return unquote(m.group(1))\n", "        m = re.search(r'filename=\"?([^\";]+)\"?', cd)\n", "        if m:\n", "            return m.group(1)\n", "    # fallback to last part of URL\n", "    return urlsplit(url).path.split('/')[-1] or \"downloaded_file\"\n", "\n", "def download_to_path(url, outdir=\"downloads\"):\n", "    os.makedirs(outdir, exist_ok=True)\n", "    headers = {\"User-Agent\":\"Mozilla/5.0\"}\n", "    try:\n", "        r = requests.get(url, headers=headers, stream=True, timeout=60)\n", "        r.raise_for_status()\n", "        fname = filename_from_cd(r, url)\n", "        local = os.path.join(outdir, fname)\n", "        with open(local, \"wb\") as f:\n", "            for chunk in r.iter_content(32768):\n", "                if chunk:\n", "                    f.write(chunk)\n", "        print(\"Downloaded:\", local)\n", "        return local\n", "    except Exception as e:\n", "        print(\"Download failed:\", e)\n", "        return None\n", "\n", "def extract_if_archive(path, outdir=\"downloads\"):\n", "    found = []\n", "    lower = path.lower()\n", "    if zipfile.is_zipfile(path):\n", "        with zipfile.ZipFile(path, 'r') as z:\n", "            z.extractall(outdir)\n", "            for name in z.namelist():\n", "                found.append(os.path.join(outdir, name))\n", "    elif tarfile.is_tarfile(path):\n", "        with tarfile.open(path, 'r:*') as t:\n", "            t.extractall(outdir)\n", "            for member in t.getmembers():\n", "                found.append(os.path.join(outdir, member.name))\n", "    else:\n", "        # not archive, return the file itself\n", "        found.append(path)\n", "    return found\n", "\n", "def is_epg_file(path):\n", "    p = path.lower()\n", "    return p.endswith(\".xml\") or p.endswith(\".xml.gz\") or p.endswith(\".gz\")\n", "\n", "def is_m3u_file(path):\n", "    p = path.lower()\n", "    return p.endswith(\".m3u\") or p.endswith(\".m3u8\") or p.endswith(\".txt\")" ] }, { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [ "# خلية 4: حاول تنزيل رابط FromSmash وادماجه في قائمة الملفات للمعالجة\n", "downloaded_files = []\n", "\n", "if smash_url and smash_url.strip():\n", "    local = download_to_path(smash_url.strip())\n", "    if local:\n", "        extracted = extract_if_archive(local)\n", "        for f in extracted:\n", "            if os.path.isfile(f):\n", "                downloaded_files.append(f)\n", "\n", "# بالإضافة إلى الروابط المعروفة، سنحاول تنزيلها أيضًا (ستنزل في نفس مجلد downloads)\n", "for link in epg_links:\n", "    try:\n", "        path = download_to_path(link)\n", "        if path:\n", "            downloaded_files.append(path)\n", "    except Exception as e:\n", "        print(\"Could not download\", link, e)\n", "\n", "print(\"\\nAll candidate files found:\")\n", "for p in downloaded_files:\n", "    print(\"-\", p)" ] }, { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [ "# خلية 5: إذا لم يتم تنزيل ملف M3U من Smash أو الروابط، اطلب رفعه يدوياً (خاص بـ Colab)\n", "m3u_text = None\n", "try:\n", "    from google.colab import files\n", "    print(\"\\nإذا عندك ملف M3U محلي تبي تضمّه، ارفعه الآن (اختياري).\")\n", "    uploaded = files.upload()  # user can upload zero or more files\n", "    if uploaded:\n", "        for name, data in uploaded.items():\n", "            # حفظ الملف المرفوع\n", "            path = os.path.join(\"downloads\", name)\n", "            with open(path, \"wb\") as f:\n", "                f.write(data)\n", "            downloaded_files.append(path)\n", "            if is_m3u_file(path):\n", "                m3u_text = open(path, 'r', encoding='utf-8', errors='ignore').read()\n", "                print(\"Uploaded and loaded M3U:\", path)\n", "except Exception:\n", "    # not in Colab or user skipped upload\n", "    pass" ] }, { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [ "# خلية 6: دمج ملفات EPG (xml / .gz) مع تجاهل التكرار حسب القواعد المطلوبة\n", "def parse_epg_file(path):\n", "    try:\n", "        if path.lower().endswith(\".gz\"):\n", "            with gzip.open(path, 'rb') as f:\n", "                data = f.read()\n", "            root = ET.fromstring(data)\n", "        else:\n", "            root = ET.parse(path).getroot()\n", "        return root\n", "    except Exception as e:\n", "        print(\"Failed parse:\", path, e)\n", "        return None\n", "\n", "channels = OrderedDict()\n", "programs_set = set()\n", "programs_list = []\n", "display_to_id = {}\n", "\n", "def norm(s):\n", "    if s is None: return \"\"\n", "    return re.sub(r\"\\s+\", \" \", s.strip().lower())\n", "\n", "for path in downloaded_files:\n", "    if not os.path.isfile(path):\n", "        continue\n", "    if is_epg_file(path):\n", "        print(\"Parsing EPG file:\", path)\n", "        root = parse_epg_file(path)\n", "        if root is None:\n", "            continue\n", "        for child in list(root):\n", "            tag = child.tag.lower()\n", "            # tag may have namespace: use endswith\n", "            if tag.endswith(\"channel\"):\n", "                ch_id = child.get('id') or \"\"\n", "                if not ch_id:\n", "                    dn = child.find('.//display-name')\n", "                    if dn is not None and dn.text:\n", "                        ch_id = norm(dn.text)\n", "                if ch_id:\n", "                    channels[ch_id] = child  # latest replaces earlier\n", "                    dn = child.find('display-name')\n", "                    if dn is not None and dn.text:\n", "                        display_to_id[norm(dn.text)] = ch_id\n", "            elif tag.endswith(\"programme\"):\n", "                ch = child.get('channel') or \"\"\n", "                start = child.get('start') or \"\"\n", "                stop = child.get('stop') or \"\"\n", "                title_elem = child.find('title')\n", "                title = title_elem.text if title_elem is not None and title_elem.text else \"\"\n", "                key = (ch, start, stop, norm(title))\n", "                if key in programs_set:\n", "                    continue\n", "                programs_set.add(key)\n", "                programs_list.append(child)\n", "    else:\n", "        print(\"Skipping non-EPG file:\", path)\n", "\n", "# build final tree and save\n", "tv_root = ET.Element(\"tv\")\n", "for ch in channels.values():\n", "    tv_root.append(ch)\n", "for p in programs_list:\n", "    tv_root.append(p)\n", "\n", "ET.ElementTree(tv_root).write(OUTPUT_EPG, encoding=\"utf-8\", xml_declaration=True)\n", "print(\"Saved EPG:\", OUTPUT_EPG)" ] }, { "cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": [ "# خلية 7: إنشاء أو تحديث M3U بناءً على القنوات الموجودة وربط tvg-id\n", "def create_m3u_from_channels(ch_dict, output_path, epg_ref=OUTPUT_EPG):\n", "    header = f'#EXTM3U tvg-url=\"{epg_ref}\"\\n'\n", "    lines = [header]\n", "    for ch_id, ch_elem in ch_dict.items():\n", "        dn = ch_elem.find('display-name')\n", "        name = dn.text.strip() if dn is not None and dn.text else ch_id\n", "        icon = ch_elem.find('icon')\n", "        logo = icon.get('src') if icon is not None and icon.get('src') else \"\"\n", "        ext = f'#EXTINF:-1 tvg-id=\"{ch_id}\" tvg-name=\"{name}\"'\n", "        if logo:\n", "            ext += f' tvg-logo=\"{logo}\"'\n", "        ext += f', {name}\\n'\n", "        stream = f'http://---/stream/{ch_id}\\n'\n