    "# خلية 7: إنشاء أو تحديث M3U بناءً على القنوات الموجودة وربط tvg-id\n",
    "def create_m3u_from_channels(ch_dict, output_path, epg_ref=OUTPUT_EPG):\n",
    "    header = f'#EXTM3U tvg-url=\"{epg_ref}\"\\n'\n",
    "    lines = [header]\n",
    "    for ch_id, ch_elem in ch_dict.items():\n",
    "        dn = ch_elem.find('display-name')\n",
    "        name = dn.text.strip() if dn is not None and dn.text else ch_id\n",
    "        icon = ch_elem.find('icon')\n",
    "        logo = icon.get('src') if icon is not None and icon.get('src') else \"\"\n",
    "        ext = f'#EXTINF:-1 tvg-id=\"{ch_id}\" tvg-name=\"{name}\"'\n",
    "        if logo:\n",
    "            ext += f' tvg-logo=\"{logo}\"'\n",
    "        ext += f', {name}\\n'\n",
    "        stream = f'http://---/stream/{ch_id}\\n'\n",
    "        lines.append(ext); lines.append(stream)\n",
    "    with open(output_path, 'w', encoding='utf-8') as f:\n",
    "        f.writelines(lines)\n",
    "    print(\\"Created M3U:\\", output_path)\n",
    "\n",
    "def update_m3u_text(m3u_text, ch_map, output_path, epg_ref=OUTPUT_EPG):\n",
    "    out = []\n",
    "    lines = m3u_text.splitlines()\n",
    "    for i, line in enumerate(lines):\n",
    "        if i==0 and line.startswith('#EXTM3U'):\n",
    "            if 'tvg-url' not in line:\n",
    "                out.append(line + f' tvg-url=\"{epg_ref}\"')\n",
    "            else:\n",
    "                out.append(line)\n",
    "            continue\n",
    "        if line.startswith('#EXTINF'):\n",
    "            m = re.search(r',\\s*(.+)$', line)\n",
    "            disp = m.group(1) if m else \"\"\n",
    "            nid = ch_map.get(norm(disp))\n",
    "            if nid:\n",
    "                if 'tvg-id=\"' in line:\n",
    "                    line = re.sub(r'tvg-id=\"[^\"]*\"', f'tvg-id=\"{nid}\"', line)\n",
    "                else:\n",
    "                    line = line.replace(',', f' tvg-id=\"{nid}\",')\n",
    "            out.append(line)\n",
    "        else:\n",
    "            out.append(line)\n",
    "    with open(output_path, 'w', encoding='utf-8') as f:\n",
    "        f.write(\\"\\n\\".join(out))\n",
    "    print(\\"Updated M3U:\\", output_path)\n",
    "\n",
    "# try to find any m3u files among downloaded_files\n",
    "found_m3u = None\n",
    "for p in downloaded_files:\n",
    "    if is_m3u_file(p):\n",
    "        found_m3u = p\n",
    "        break\n",
    "\n",
    "if found_m3u:\n",
    "    print(\\"Found M3U to update:\\", found_m3u)\n",
    "    txt = open(found_m3u, 'r', encoding='utf-8', errors='ignore').read()\n",
    "    update_m3u_text(txt, display_to_id, OUTPUT_M3U)\n",
    "else:\n",
    "    create_m3u_from_channels(channels, OUTPUT_M3U)"
   ]
  },
