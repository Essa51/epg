 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "نوتبوك جاهز لدمج EPG مع M3U وإنتاج ملف m3u مفلتر + final_epg.xml + تقارير.\n",
    "شغّل الخلايا بالترتيب (Runtime → Run all) في Colab.\n",
    "- سيقوم بتنزيل EPG من jsDelivr (v1.0)\n",
    "- سيقوم بتنزيل M3U من رابط Dropbox (dl=1)\n",
    "- يطابق القنوات ويحدّث/يضيف tvg-id عند الإمكان\n",
    "- ينتج final_m3u.m3u و final_epg.xml و reports/missing_tvg_ids.txt و merged_epg_m3u.zip\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# تثبيت المكتبات الضرورية\n",
    "!pip install -q requests"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ضبط المتغيرات (عدل الروابط إذا احتجت)\n",
    "DROPBOX_M3U = \"https://www.dropbox.com/scl/fi/2orac50oxwxqt3pqfgcpi/_1TeestPlayllistlion.txt?rlkey=lnfzaaugig09nv2uanheww0cl&st=39swgzp2&dl=1\"\n",
    "EPG_CDN = \"https://cdn.jsdelivr.net/gh/Essa51/arabic_epg.xml@v1.0/arabic_clean_epg.xml\"\n",
    "OUTPUT_M3U = \"final_m3u.m3u\"\n",
    "OUTPUT_EPG = \"final_epg.xml\"\n",
    "REPORTS_DIR = \"reports\"\n",
    "ZIP_OUTPUT = \"merged_epg_m3u.zip\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests, re, os, zipfile, xml.etree.ElementTree as ET\n",
    "from urllib.parse import urlsplit, unquote\n",
    "\n",
    "os.makedirs(REPORTS_DIR, exist_ok=True)\n",
    "\n",
    "def download_text(url, timeout=60):\n",
    "    r = requests.get(url, timeout=timeout)\n",
    "    r.raise_for_status()\n",
    "    return r.content.decode('utf-8', errors='ignore')\n",
    "\n",
    "def norm(s):\n",
    "    if not s: return \"\"\n",
    "    return re.sub(r\"\\s+\", \" \", s.strip().lower())\n",
    "\n",
    "# 1) تنزيل EPG وحفظه + استخراج خريطة name->id\n",
    "print('Downloading EPG...')\n",
    "epg_text = download_text(EPG_CDN)\n",
    "with open(OUTPUT_EPG, 'w', encoding='utf-8') as f:\n",
    "    f.write(epg_text)\n",
    "\n",
    "root = ET.fromstring(epg_text)\n",
    "epg_ids = set()\n",
    "name_to_id = {}\n",
    "for ch in root.findall('.//channel'):\n",
    "    ch_id = ch.get('id') or ''\n",
    "    if ch_id:\n",
    "        epg_ids.add(ch_id)\n",
    "    dn = ch.find('display-name')\n",
    "    if dn is None:\n",
    "        for child in ch:\n",
    "            if child.tag.lower().endswith('display-name'):\n",
    "                dn = child\n",
    "                break\n",
    "    if dn is not None and dn.text:\n",
    "        name_to_id[norm(dn.text)] = ch_id\n",
    "\n",
    "print(f'EPG channels: {len(epg_ids)}, names mapped: {len(name_to_id)}')\n",
    "\n",
    "# 2) تنزيل M3U وتحليله\n",
    "print('Downloading M3U...')\n",
    "m3u_text = download_text(DROPBOX_M3U)\n",
    "lines = m3u_text.splitlines()\n",
    "entries = []\n",
    "i = 0\n",
    "while i < len(lines):\n",
    "    line = lines[i].strip()\n",
    "    if line.upper().startswith('#EXTINF'):\n",
    "        ext = line\n",
    "        stream = lines[i+1].strip() if i+1 < len(lines) else ''\n",
    "        attrs = {}\n",
    "        for m in re.finditer(r'([a-zA-Z0-9\\-]+)=[\"\']([^\"\']+)[\"\']', ext):\n",
    "            attrs[m.group(1)] = m.group(2)\n",
    "        mname = re.search(r',\\s*(.+)$', ext)\n",
    "        name = mname.group(1).strip() if mname else ''\n",
    "        entries.append({'ext': ext, 'stream': stream, 'attrs': attrs, 'name': name})\n",
    "        i += 2\n",
    "    else:\n",
    "        i += 1\n",
    "\n",
    "print(f'Parsed entries: {len(entries)} (with tvg-id: {sum(1 for e in entries if \"tvg-id\" in e[\'attrs\'])})')\n",
    "\n",
    "# 3) مطابقة tvg-id باستخدام EPG أو اسم القناة\n",
    "kept = []\n",
    "missing = []\n",
    "for e in entries:\n",
    "    tvg = e['attrs'].get('tvg-id')\n",
    "    assigned = None\n",
    "    if tvg and tvg in epg_ids:\n",
    "        assigned = tvg\n",
    "    else:\n",
    "        n = norm(e['name'])\n",
    "        if n and n in name_to_id and name_to_id[n]:\n",
    "            assigned = name_to_id[n]\n",
    "    if assigned:\n",
    "        e['attrs']['tvg-id'] = assigned\n",
    "        kept.append(e)\n",
    "    else:\n",
    "        missing.append(e)\n",
    "\n",
    "print(f'Kept after matching: {len(kept)}, Missing: {len(missing)}')\n",
    "\n",
    "# 4) إعادة بناء أسطر EXTINF وحفظ M3U الجديد\n",
    "def rebuild_extinf(e):\n",
    "    prefix_m = re.match(r'(#EXTINF:[^ ]*)(.*)', e['ext'], re.IGNORECASE)\n",
    "    if prefix_m:\n",
    "        prefix = prefix_m.group(1)\n",
    "    else:\n",
    "        prefix = '#EXTINF:-1'\n",
    "    attr_parts = []\n",
    "    if 'tvg-id' in e['attrs']:\n",
    "        attr_parts.append(f'tvg-id=\"{e['attrs']['tvg-id']}\"')\n",
    "    for k,v in e['attrs'].items():\n",
    "        if k == 'tvg-id': continue\n",
    "        attr_parts.append(f'{k}=\"{v}\"')\n",
    "    attrs_str = ' '.join(attr_parts)\n",
    "    name = e['name'] or ''\n",
    "    return f"{prefix} {attrs_str}, {name}".strip()\n",
    "\n",
    "with open(OUTPUT_M3U, 'w', encoding='utf-8') as f:\n",
    "    f.write(f'#EXTM3U tvg-url=\"{EPG_CDN}\"\\n')\n",
    "    for e in kept:\n",
    "        f.write(rebuild_extinf(e) + '\\n')\n",
    "        f.write((e['stream'] or '') + '\\n')\n",
    "\n",
    "# 5) حفظ تقرير القنوات المفقودة\n",
    "missing_path = os.path.join(REPORTS_DIR, 'missing_tvg_ids.txt')\n",
    "with open(missing_path, 'w', encoding='utf-8') as f:\n",
    "    for e in missing:\n",
    "        f.write((e['attrs'].get('tvg-id','')) + '\\t' + e['name'] + '\\t' + e['stream'] + '\\n')\n",
    "\n",
    "# 6) إنشاء ZIP يحتوي على final_epg.xml و final_m3u.m3u\n",
    "with zipfile.ZipFile(ZIP_OUTPUT, 'w', zipfile.ZIP_DEFLATED) as z:\n",
    "    z.write(OUTPUT_EPG)\n",
    "    z.write(OUTPUT_M3U)\n",
    "\n",
    "print('Outputs created:')\n",
    "print(' -', OUTPUT_EPG)\n",
    "print(' -', OUTPUT_M3U)\n",
    "print(' -', missing_path)\n",
    "print(' -', ZIP_OUTPUT)\n",
    "\n",
    "# تنزيل الملفات تلقائياً في Colab (إن وُجد)\n",
    "try:\n",
    "    from google.colab import files\n",
    "    files.download(OUTPUT_M3U)\n",
    "    files.download(OUTPUT_EPG)\n",
    "    files.download(ZIP_OUTPUT)\n",
    "except Exception:\n",
    "    pass\n"
   ]
  }
 ],
